# Copy to .env and edit. The server reads process environment variables.
# A local .env file is not loaded automatically. Export these, or use config.json.

PORT=3003
HOST=0.0.0.0
DATABASE_PATH=./data/accounting.db
BACKUP_DIR=./data/backups
UPLOAD_DIR=./data/uploads
LOG_LEVEL=info
REPORT_TIMEZONE=UTC

# Optional HTTPS. Leave blank for HTTP.
TLS_KEY=
TLS_CERT=

# Optional WP EasyCart / MySQL import. Off unless EASYCART_ENABLED=1.
EASYCART_ENABLED=0
EASYCART_MODE=local
EASYCART_MYSQL_HOST=
EASYCART_MYSQL_USER=
EASYCART_MYSQL_PASSWORD=
EASYCART_MYSQL_DATABASE=
EASYCART_REMOTE_URL=
EASYCART_REMOTE_USER=
EASYCART_REMOTE_PASSWORD=
EASYCART_REMIT_FEE_RATE=0
EASYCART_CLEAN_START=
EASYCART_IMPORT_OWNER=party_a
